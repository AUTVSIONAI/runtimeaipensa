[runtime.plugins.config.backends.nvidia]
api_key = "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"
base_url = "https://integrate.api.nvidia.com/v1"

[browser]
runtime = "local"
headless = false
chrome_path = ""
wss_url = ""
cdp_url = ""
disable_security = true
extra_args = [
    "--no-sandbox",
    "--disable-gpu",
    "--disable-dev-shm-usage",
]

[browser.proxy]
server = ""
username = ""
password = ""

[browser.context_config]
user_agent = ""
locale = "en-US"
timezone_id = "UTC"
permissions = [
    "geolocation",
    "notifications",
]
java_script_enabled = true
accept_downloads = true
ignore_https_errors = true
record_video_dir = ""

[browser.context_config.viewport]
width = 1280
height = 720

[browser.context_config.geolocation]
latitude = 0
longitude = 0

[browser.context_config.record_video_size]
width = 1280
height = 720

[sandbox]
runtime = "local"
work_dir = "workspace"
timeout = 300
memory_limit = "2g"
cpu_limit = "2"
network_mode = "bridge"

[sandbox.env]

[memory]

[llm]
default_model = "meta/llama-3.1-70b-instruct"
temperature = 0.1
max_tokens = 8192
timeout = 60
api_key = "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"
base_url = "https://integrate.api.nvidia.com/v1"

[llm.models.gpt-4]
provider = "openai"
model = "gpt-4"

[llm.models.gpt-3.5-turbo]
provider = "openai"
model = "gpt-3.5-turbo"

[llm.models.claude-3-opus]
provider = "anthropic"
model = "claude-3-opus-20240229"

[llm.models.claude-3-sonnet]
provider = "anthropic"
model = "claude-3-sonnet-20240229"

[llm.models.claude-3-haiku]
provider = "anthropic"
model = "claude-3-haiku-20240307"

[mcp.servers]

[tools]
approval_required = [
    "execute_shell",
    "write_file",
    "delete_file",
]

[events]
enabled = true
async_handlers = true
max_history = 10000

[telemetry]
enabled = true
metrics_interval = 60
trace_sampling = 0.1

[security]
sandbox_enabled = true
allowed_commands = []
blocked_commands = [
    "rm -rf /",
    "sudo",
    "chmod 777",
]
max_execution_time = 300
max_memory_mb = 1024
network_allowed = true
file_system_allowed = true
