log_level = "DEBUG"

[runtime]
type = "local"
name = "AIPENSA-Runtime"
version = "1.0.0"
workspace = "workspace"
log_level = "INFO"

[runtime.modules]
mcp = [
    { name = "local-mcp", enabled = true, required = false, config = {} },
]
workflow = [
    { name = "workflow", enabled = true, required = false, config = {} },
]
scheduler = [
    { name = "scheduler", enabled = true, required = false, config = {} },
]
queue = [
    { name = "queue", enabled = true, required = false, config = {} },
]
notification = [
    { name = "notification", enabled = true, required = false, config = {} },
]
storage = [
    { name = "storage", enabled = true, required = false, config = {} },
]
authentication = [
    { name = "authentication", enabled = true, required = false, config = {} },
]
workspace = [
    { name = "workspace", enabled = true, required = false, config = {} },
]
voice = [
    { name = "voice", enabled = true, required = false, config = {} },
]
vision = [
    { name = "vision", enabled = true, required = false, config = {} },
]
video = [
    { name = "video", enabled = true, required = false, config = {} },
]
image = [
    { name = "image", enabled = true, required = false, config = {} },
]
embedding = [
    { name = "embedding", enabled = true, required = false, config = {} },
]
rag = [
    { name = "rag", enabled = true, required = false, config = {} },
]
reasoning = [
    { name = "reasoning", enabled = true, required = false, config = {} },
]

[[runtime.modules.browser]]
name = "local-browser"
enabled = true
required = true

[runtime.modules.browser.config]
headless = false
disable_security = true

[runtime.modules.browser.config.viewport]
width = 1280
height = 720

[[runtime.modules.execution]]
name = "local-execution"
enabled = true
required = true

[runtime.modules.execution.config]
work_dir = "workspace"
timeout = 300
max_sandboxes = 10

[[runtime.modules.tools]]
name = "local-tools"
enabled = true
required = true

[runtime.modules.tools.config]
approval_required = [
    "execute_shell",
]

[[runtime.modules.memory]]
name = "local-memory"
enabled = true
required = false

[runtime.modules.memory.config]
persist_path = "runtime/memory"
max_entries = 10000
default_ttl = 86400

[[runtime.modules.planning]]
name = "local-planning"
enabled = true
required = false

[runtime.modules.planning.config.llm]
model = "gpt-4"
temperature = 0.1

[[runtime.modules.filesystem]]
name = "local-filesystem"
enabled = true
required = true

[runtime.modules.filesystem.config]
workspace = "workspace"
allowed_paths = []
blocked_paths = [
    ".git",
    "__pycache__",
    "node_modules",
    ".venv",
]

[[runtime.modules.network]]
name = "local-network"
enabled = true
required = true

[runtime.modules.network.config]
timeout = 30
max_connections = 100
verify_ssl = true

[[runtime.modules.docker]]
name = "local-docker"
enabled = false
required = false

[runtime.modules.docker.config]
docker_url = "unix:///var/run/docker.sock"

[[runtime.modules.conversation]]
name = "conversation"
enabled = true
required = false

[runtime.modules.conversation.config]
persist_path = "runtime/conversations"
max_conversations = 1000
default_max_messages = 100
default_max_tokens = 8000

[[runtime.modules.agent]]
name = "agent"
enabled = true
required = false

[runtime.modules.agent.config]
max_agents = 100
default_timeout = 3600

[[runtime.modules.llm]]
name = "llm"
enabled = true
required = false

[runtime.modules.llm.config]
default_model = "meta/llama-3.1-70b-instruct"

[runtime.modules.llm.config.backends.nvidia]
api_key = "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"
base_url = "https://integrate.api.nvidia.com/v1"

[[runtime.plugins]]
id = "local-browser"
enabled = true
required = true

[runtime.plugins.config]

[[runtime.plugins]]
id = "local-execution"
enabled = true
required = true

[runtime.plugins.config]

[[runtime.plugins]]
id = "local-tools"
enabled = true
required = true

[runtime.plugins.config]

[[runtime.plugins]]
id = "local-memory"
enabled = true
required = false

[runtime.plugins.config]

[[runtime.plugins]]
